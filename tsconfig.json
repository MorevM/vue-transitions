{
	"compilerOptions": {
		"target": "ES6",
		"module": "ESNext",
		"lib": ["ESNext"],
		"moduleResolution": "Bundler",
		"esModuleInterop": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"checkJs": false,
		"allowJs": true,
		"skipLibCheck": true,
		"paths": {
			"type-fest": ["./node_modules/type-fest/"],
		},
	},
	"exclude": [
		"build",
		"dist",
		"tests",
	],
}
