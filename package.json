{
	"name": "@morev/vue-transitions",
	"description": "Shareable Vue transitions library",
	"type": "module",
	"private": false,
	"sideEffects": [
		"**/*.css",
		"dist/**/vue-transitions.browser.*"
	],
	"version": "4.0.0",
	"packageManager": "pnpm@12.6.0",
	"workspaces": [
		"builders/*"
	],
	"engines": {
		"node": ">= 18.12.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"author": {
		"name": "Maxim Morev",
		"email": "max.seainside@gmail.com"
	},
	"contributors": [
		{
			"name": "Andrey Litvinov",
			"email": "fro1d616@gmail.com"
		},
		{
			"name": "Behon Baker",
			"email": "behon.baker@yahoo.com"
		}
	],
	"homepage": "https://github.com/MorevM/vue-transitions#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/MorevM/vue-transitions"
	},
	"keywords": [
		"vue",
		"transition",
		"animation"
	],
	"files": [
		"dist/vue2",
		"dist/vue3",
		"vetur",
		"types",
		"nuxt"
	],
	"exports": {
		".": {
			"import": {
				"types": "./types/vue3.d.ts",
				"browser": "./dist/vue3/vue-transitions.browser.js",
				"default": "./dist/vue3/vue-transitions.js"
			},
			"require": {
				"types": "./types/vue3.d.cts",
				"browser": "./dist/vue3/vue-transitions.browser.cjs",
				"default": "./dist/vue3/vue-transitions.cjs"
			}
		},
		"./nuxt": {
			"import": {
				"types": "./nuxt/module.d.mts",
				"default": "./nuxt/module.mjs"
			},
			"require": {
				"types": "./nuxt/module.d.cts",
				"default": "./nuxt/module.cjs"
			}
		},
		"./styles": {
			"types": "./types/styles.d.ts",
			"default": "./dist/vue3/index.css"
		},
		"./vue2": {
			"import": {
				"types": "./types/vue2.d.ts",
				"browser": "./dist/vue2/vue-transitions.browser.js",
				"default": "./dist/vue2/vue-transitions.js"
			},
			"require": {
				"types": "./types/vue2.d.cts",
				"browser": "./dist/vue2/vue-transitions.browser.cjs",
				"default": "./dist/vue2/vue-transitions.cjs"
			}
		},
		"./vue3": {
			"import": {
				"types": "./types/vue3.d.ts",
				"browser": "./dist/vue3/vue-transitions.browser.js",
				"default": "./dist/vue3/vue-transitions.js"
			},
			"require": {
				"types": "./types/vue3.d.cts",
				"browser": "./dist/vue3/vue-transitions.browser.cjs",
				"default": "./dist/vue3/vue-transitions.cjs"
			}
		}
	},
	"main": "./dist/vue3/vue-transitions.cjs",
	"module": "./dist/vue3/vue-transitions.browser.js",
	"types": "./types/vue3.d.ts",
	"scripts": {
		"dev": "pnpm docs:dev",
		"build:vue2": "pnpm --filter vue2-builder build",
		"build:vue3": "pnpm --filter vue3-builder build",
		"build:browser-entrypoints": "node ./scripts/browser-entrypoints.js",
		"build:styles": "node ./scripts/verify-shared-styles.js",
		"build:nuxt": "node ./scripts/nuxt-module-build.js",
		"build": "pnpm run build:vue2 && pnpm run build:vue3 && pnpm run build:browser-entrypoints && pnpm run build:styles && pnpm run build:nuxt",
		"docs:dev": "pnpm --filter @morev/vue-transitions-docs dev",
		"docs:build": "pnpm --filter @morev/vue-transitions-docs build",
		"docs:preview": "pnpm --filter @morev/vue-transitions-docs preview",
		"docs:typecheck": "pnpm --filter @morev/vue-transitions-docs typecheck",
		"prepare": "lefthook install",
		"release": "release-it",
		"lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
		"lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:stylelint:fix",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix",
		"lint:stylelint": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
		"lint:stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix --allow-empty-input",
		"test": "vitest",
		"test:consumers": "pnpm run build && node ./scripts/test-consumers.mjs",
		"test:e2e": "pnpm run typecheck:e2e && playwright test",
		"test:e2e:update": "pnpm run typecheck:e2e && playwright test --update-snapshots",
		"test:e2e:ui": "pnpm run typecheck:e2e && playwright test --ui",
		"typecheck:e2e": "tsc --noEmit --project tests/e2e/tsconfig.json",
		"test:dev": "vitest --watch"
	},
	"peerDependencies": {
		"vue": "^2.6.14 || >=3"
	},
	"dependencies": {
		"@morev/utils": "^3.11.1",
		"@nuxt/kit": "^3.13.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@fontsource/dejavu-sans": "^5.3.0",
		"@morev/commitlint-config": "^0.2.2",
		"@morev/eslint-config": "^43.0.0",
		"@morev/stylelint-config": "^9.0.2",
		"@nuxt/schema": "^3.13.2",
		"@playwright/test": "~1.62.1",
		"@release-it/conventional-changelog": "^8.0.1",
		"@types/node": "^24.19.0",
		"eslint": "^10.11.0",
		"lefthook": "^2.1.16",
		"postcss": "^8.5.28",
		"release-it": "^21.1.0",
		"sass": "^1.105.1",
		"stylelint": "^17.15.0",
		"terser": "^5.29.1",
		"typescript": "^6.0.3",
		"unbuild": "^3.6.1",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"vue": "^2.7.16",
		"vue-types": "^4.2.1"
	},
	"vetur": {
		"tags": "vetur/tags.json",
		"attributes": "vetur/attributes.json"
	}
}
